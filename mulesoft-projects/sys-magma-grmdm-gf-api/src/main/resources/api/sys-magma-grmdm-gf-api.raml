#%RAML 1.0
title: MAGMA GRMDM System API
version: v1
baseUri: https://api.organization.com/sys/magma/grmdm/{version}
mediaType: [application/json]

documentation:
  - title: Overview
    content: System API for MAGMA GRMDM data operations

types:
  CompanyData:
    type: object
    properties:
      companyId: string
      companyName: string
      status: string
      createdDate: datetime

/companies:
  get:
    description: Retrieve company data from GRMDM
    responses:
      200:
        body:
          application/json:
            type: CompanyData[]

/health:
  get:
    responses:
      200:
        body:
          application/json:
            example: |
              {"status": "UP"}
