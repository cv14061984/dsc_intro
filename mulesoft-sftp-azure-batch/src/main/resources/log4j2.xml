<?xml version="1.0" encoding="utf-8"?>
<Configuration>
    <Appenders>
        <RollingFile name="file" fileName="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}sftp-azure-batch.log"
                     filePattern="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}sftp-azure-batch-%i.log">
            <PatternLayout pattern="%-5p %d [%t] [processor: %X{processorPath}; event: %X{correlationId}] %c: %m%n"/>
            <SizeBasedTriggeringPolicy size="10 MB"/>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%-5p %d [%t] [processor: %X{processorPath}; event: %X{correlationId}] %c: %m%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <!-- Application Logger -->
        <AsyncLogger name="com.example.mulesoft" level="${log.level:-INFO}"/>

        <!-- Mule Core Loggers -->
        <AsyncLogger name="org.mule.runtime.core.internal.processor.LoggerMessageProcessor" level="INFO"/>

        <!-- HTTP Connector Logger -->
        <AsyncLogger name="org.mule.extension.http" level="WARN"/>

        <!-- SFTP Connector Logger -->
        <AsyncLogger name="org.mule.extension.sftp" level="INFO"/>

        <!-- Reduce noise from third-party libraries -->
        <AsyncLogger name="com.mulesoft.mule.runtime.plugin" level="WARN"/>
        <AsyncLogger name="org.apache.sshd" level="WARN"/>
        <AsyncLogger name="org.apache.http" level="WARN"/>

        <AsyncRoot level="INFO">
            <AppenderRef ref="file"/>
            <AppenderRef ref="Console"/>
        </AsyncRoot>
    </Loggers>
</Configuration>
